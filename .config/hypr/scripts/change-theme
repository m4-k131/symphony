#!/bin/bash
# Dynamic wallpaper + color generation via matugen.
# Usage: change-theme [subfolder]
#   no args    — pick random wallpaper from ~/Pictures/Wallpaper/ (dynamic mode)
#   subfolder  — pick first wallpaper from ~/Pictures/Wallpaper/<subfolder>/
#                and generate colors into ~/.config/symphony/subfolders/<subfolder>/

if command -v swww >/dev/null 2>&1; then
	wallbin=swww
elif command -v awww >/dev/null 2>&1; then
	wallbin=awww
else
	notify-send "No wallpaper daemon found" "Please install awww and try again"
	exit 1
fi

SUBFOLDER="${1:-}"
SYMPHONY_DIR="$HOME/.config/symphony"
DOTFILES="${DOTFILES:-$HOME/dotfiles}"

if [[ -n "$SUBFOLDER" ]]; then
	# Subfolder mode: generate colors into subfolder target dir
	TARGET_DIR="$SYMPHONY_DIR/subfolders/$SUBFOLDER"
	WALLPAPER_DIR="$HOME/Pictures/Wallpaper/$SUBFOLDER"
else
	# Dynamic mode: check if theme is locked
	CURRENT_THEME=$(cat "$SYMPHONY_DIR/.current-theme" 2>/dev/null || echo "dynamic")
	if [[ "$CURRENT_THEME" != "dynamic" ]]; then
		notify-send "Theme Locked" "Switch to Dynamic first"
		exit 0
	fi

	TARGET_DIR="$SYMPHONY_DIR/dynamic"
	WALLPAPER_DIR="$HOME/Pictures/Wallpaper"
fi

STATE_FILE="$HOME/.current_wallpaper_index"

# Set up target dir: copy static files from repo, then matugen generates the rest
mkdir -p "$TARGET_DIR"
if [[ -d "$DOTFILES/themes/dynamic/static" ]]; then
	cp -r "$DOTFILES/themes/dynamic/static/." "$TARGET_DIR/"
fi

# Gather wallpapers
if [[ -n "$SUBFOLDER" ]]; then
	mapfile -t WALLPAPERS < <(find "$WALLPAPER_DIR" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.jpeg' \) | sort)
else
	mapfile -t WALLPAPERS < <(find "$WALLPAPER_DIR" -type f \( -iname '*.jpg' -o -iname '*.png' \) | sort)
fi

NUM_WALLPAPERS=${#WALLPAPERS[@]}
if [ "$NUM_WALLPAPERS" -eq 0 ]; then
	if [[ -n "$SUBFOLDER" ]]; then
		notify-send "No Wallpapers" "No images found in ~/Pictures/Wallpaper/$SUBFOLDER"
	else
		(action=$(notify-send -A "open=Get Wallpapers" --wait "No Wallpapers Found" "Add images to ~/Pictures/Wallpaper to use dynamic theming") && [[ "$action" == "open" ]] && xdg-open "https://github.com/vyrx-dev/Wallpapers") &
	fi
	exit 1
fi

if [[ -n "$SUBFOLDER" ]]; then
	# Use first wallpaper (sorted) for subfolder lock
	INDEX=0
else
	if [ -f "$STATE_FILE" ]; then
		INDEX=$(<"$STATE_FILE")
		INDEX=$((RANDOM % NUM_WALLPAPERS))
	else
		INDEX=0
	fi
	echo "$INDEX" >"$STATE_FILE"
fi

CURRENT_WALLPAPER="${WALLPAPERS[$INDEX]}"

# Start wallpaper daemon if needed
"$wallbin" query &>/dev/null || "$wallbin"-daemon --format xrgb

"$wallbin" img "$CURRENT_WALLPAPER" \
	--transition-type center \
	--transition-pos top-right \
	--transition-fps 120 \
	--transition-duration 1 \
	--transition-bezier 0.25,0.1,0.25,1.0

# Update wallpaper symlink to track current wallpaper
DISPLAYED_WALLPAPER=$("$wallbin" query | grep "currently displaying" | head -1 | sed 's/.*image: //')
if [ -n "$DISPLAYED_WALLPAPER" ]; then
	ln -sf "$DISPLAYED_WALLPAPER" "$TARGET_DIR/wallpaper"
fi

SCHEME_TYPE=$(grep '^SCHEME_TYPE=' "$SYMPHONY_DIR/matugen.conf" 2>/dev/null | cut -d= -f2)

# For subfolder themes, create a temp matugen config with output paths pointing to the subfolder dir
if [[ -n "$SUBFOLDER" ]]; then
	TEMP_CONFIG=$(mktemp /tmp/matugen-subfolder-XXXXXX.toml)
	sed "s|~/.config/symphony/dynamic/|~/.config/symphony/subfolders/$SUBFOLDER/|g" "$HOME/.config/matugen/config.toml" > "$TEMP_CONFIG"
	matugen image "$CURRENT_WALLPAPER" -m dark --source-color-index 0 -t "${SCHEME_TYPE:-scheme-content}" -c "$TEMP_CONFIG"
	rm -f "$TEMP_CONFIG"
else
	matugen image "$CURRENT_WALLPAPER" -m dark --source-color-index 0 -t "${SCHEME_TYPE:-scheme-content}"
fi

# Push fitting colormap to vividspektrum if it's running
scrDir/update-spektrum-colormap &

# Update Symphony apps that need special handling
"$HOME/dotfiles/install/themes/symphony" reload

# Reload apps not handled by symphony
restart-app swayosd-server

pgrep -x nautilus >/dev/null && (
	pkill -x nautilus
	nautilus &>/dev/null &
	disown
)

if [[ -n "$SUBFOLDER" ]]; then
	notify-send -i "$CURRENT_WALLPAPER" "$SUBFOLDER" "Colors locked from wallpaper"
else
	notify-send -i "$CURRENT_WALLPAPER" "Dynamic" "Colors from wallpaper"
fi
