#!/bin/bash

# Launch a web app using Firefox PWA (firefoxpwa)
# Usage: launch-webapp <url> [arguments...]
# The URL is used to look up the installed PWA by name in the desktop file.

APP_URL="$1"
shift 2>/dev/null

# Find the web app by matching the URL in desktop files
DESKTOP_DIR="$HOME/.local/share/applications"
WEBAPP_ID=""

for desktop in "$DESKTOP_DIR"/*.desktop; do
	[[ -f "$desktop" ]] || continue
	if grep -q "X-WebApp=true" "$desktop" 2>/dev/null && grep -q "$APP_URL" "$desktop" 2>/dev/null; then
		WEBAPP_ID=$(grep -oP 'X-FirefoxPWA-ID=\K.*' "$desktop" 2>/dev/null)
		break
	fi
done

if [[ -n "$WEBAPP_ID" ]]; then
	exec setsid uwsm-app -- firefoxpwa site launch "$WEBAPP_ID" "$@" 2>/dev/null
else
	# Fallback: open in regular Firefox
	exec setsid uwsm-app -- firefox --new-window "$APP_URL" "$@" 2>/dev/null
fi
